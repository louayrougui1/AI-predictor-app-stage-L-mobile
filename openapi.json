  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "properties": {
          "token_type": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Token Type",
            "default": "Bearer"
          },
          "access_token": {
            "type": "string",
            "maxLength": 512,
            "minLength": 10,
            "title": "Access Token"
          },
          "expires_at": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Expires At",
            "description": "Unix timestamp"
          },
          "refresh_token": {
            "type": "string",
            "maxLength": 512,
            "minLength": 10,
            "title": "Refresh Token"
          },
          "refresh_token_expires_at": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Refresh Token Expires At",
            "description": "Unix timestamp"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_at",
          "refresh_token",
          "refresh_token_expires_at"
