            "title": "Machine Type"
          },
          "technician": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Technician"
          },
          "machine_age_years": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Machine Age Years"
          },
          "no_machine": {
            "type": "boolean",
            "title": "No Machine",
            "default": false
          },
          "under_warranty": {
            "type": "boolean",
            "title": "Under Warranty",
            "default": false
          },
          "sched_year": {
